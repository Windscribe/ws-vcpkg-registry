diff --git a/include/curl/curl.h b/include/curl/curl.h
index ccc9a09..5442865 100644
--- a/include/curl/curl.h
+++ b/include/curl/curl.h
@@ -973,6 +973,9 @@ typedef enum {
 /* If possible, send data using TLS 1.3 early data */
 #define CURLSSLOPT_EARLYDATA (1L << 6)
 
+#define CURLSSLOPT_TLSEXT_PADDING (1<<7)
+#define CURLSSLOPT_TLSEXT_PADDING_SUPER (1<<8)
+
 /* The default connection attempt delay in milliseconds for happy eyeballs.
    CURLOPT_HAPPY_EYEBALLS_TIMEOUT_MS.3 and happy-eyeballs-timeout-ms.d document
    this value, keep them in sync. */
diff --git a/lib/setopt.c b/lib/setopt.c
index dff8a6d..ef8407f 100644
--- a/lib/setopt.c
+++ b/lib/setopt.c
@@ -920,11 +920,11 @@ static CURLcode setopt_long_ssl(struct Curl_easy *data, CURLoption option,
       s->use_ssl = (unsigned char)arg;
     break;
   case CURLOPT_SSL_OPTIONS:
-    s->ssl.ssl_options = (unsigned char)(arg & 0xff);
+    s->ssl.ssl_options = (uint16_t)(arg & 0xffff);
     break;
 #ifndef CURL_DISABLE_PROXY
   case CURLOPT_PROXY_SSL_OPTIONS:
-    s->proxy_ssl.ssl_options = (unsigned char)(arg & 0xff);
+    s->proxy_ssl.ssl_options = (uint16_t)(arg & 0xffff);
     break;
 #endif
   case CURLOPT_SSL_ENABLE_NPN:
diff --git a/lib/vtls/openssl.c b/lib/vtls/openssl.c
index 7bb7a8c..8a92fb8 100644
--- a/lib/vtls/openssl.c
+++ b/lib/vtls/openssl.c
@@ -3820,6 +3820,14 @@ CURLcode Curl_ossl_ctx_init(struct ossl_ctx *octx,
   if(!conn_config->enable_beast)
     ctx_options &= ~(ctx_option_t)SSL_OP_DONT_INSERT_EMPTY_FRAGMENTS;
 
+  if(conn_config->tlsext_padding)
+    ctx_options |= (ctx_option_t)SSL_OP_TLSEXT_PADDING;
+
+#ifdef SSL_OP_TLSEXT_PADDING_SUPER
+  if(conn_config->tlsext_padding_super)
+    ctx_options |= (ctx_option_t)SSL_OP_TLSEXT_PADDING_SUPER;
+#endif
+
   DEBUGASSERT(ssl_version_min != CURL_SSLVERSION_DEFAULT);
   switch(ssl_version_min) {
   case CURL_SSLVERSION_SSLv2:
diff --git a/lib/vtls/vtls_config.c b/lib/vtls/vtls_config.c
index aae3212..973afe6 100644
--- a/lib/vtls/vtls_config.c
+++ b/lib/vtls/vtls_config.c
@@ -213,6 +213,8 @@ static bool clone_ssl_primary_config(struct ssl_filter_config *source,
   dest->no_partialchain = source->no_partialchain;
   dest->no_revoke = source->no_revoke;
   dest->revoke_best_effort = source->revoke_best_effort;
+  dest->tlsext_padding = source->tlsext_padding;
+  dest->tlsext_padding_super = source->tlsext_padding_super;
 
   CLONE_BLOB(cert_blob);
   CLONE_BLOB(ca_info_blob);
@@ -247,7 +249,7 @@ ssl_easy_config_compl_options(struct Curl_peer *origin,
                               struct ssl_easy_config *sslc,
                               struct ssl_filter_config *primary)
 {
-  uint8_t options = sslc->ssl_options;
+  uint16_t options = sslc->ssl_options;
   /* If set via CURLOPT_(PROXY_)SSL_OPTIONS, we definitely use it.
    * If not, we switch it on for supported backends if no custom
    * CA settings exist. */
@@ -260,6 +262,9 @@ ssl_easy_config_compl_options(struct Curl_peer *origin,
   primary->no_partialchain = !!(options & CURLSSLOPT_NO_PARTIALCHAIN);
   primary->no_revoke = !!(options & CURLSSLOPT_NO_REVOKE);
   primary->revoke_best_effort = !!(options & CURLSSLOPT_REVOKE_BEST_EFFORT);
+  primary->tlsext_padding = !!(options & CURLSSLOPT_TLSEXT_PADDING);
+  primary->tlsext_padding_super =
+    !!(options & CURLSSLOPT_TLSEXT_PADDING_SUPER);
 }
 
 static char *ssl_easy_steal(struct Curl_easy *data, enum dupstring id)
diff --git a/lib/vtls/vtls_config.h b/lib/vtls/vtls_config.h
index cf4263f..c2cf82d 100644
--- a/lib/vtls/vtls_config.h
+++ b/lib/vtls/vtls_config.h
@@ -53,7 +53,7 @@ struct ssl_filter_config {
   struct curl_blob *key_blob;
   char *curves;          /* list of curves to use */
   uint32_t version_max; /* max supported version the client wants to use */
-  uint8_t ssl_options;  /* the CURLOPT_SSL_OPTIONS bitmask */
+  uint16_t ssl_options;  /* the CURLOPT_SSL_OPTIONS bitmask */
   uint8_t version;    /* what version the client wants to use */
 #ifdef USE_ECH
   uint8_t ech;           /* TLS ECH CURLECH_((DIS|EN)ABLE|GREASE) */
@@ -72,13 +72,15 @@ struct ssl_filter_config {
   BIT(no_revoke);    /* disable SSL certificate revocation checks */
   BIT(revoke_best_effort); /* ignore SSL revocation offline/missing revocation
                               list errors */
+  BIT(tlsext_padding);
+  BIT(tlsext_padding_super);
 };
 
 struct ssl_easy_config {
   long certverifyresult; /* result from the certificate verification */
   uint32_t version_max; /* max supported version the client wants to use */
   uint8_t version;    /* what version the client wants to use */
-  uint8_t ssl_options;  /* the CURLOPT_SSL_OPTIONS bitmask */
+  uint16_t ssl_options;  /* the CURLOPT_SSL_OPTIONS bitmask */
 #ifdef USE_ECH
   uint8_t ech;           /* TLS ECH CURLECH_((DIS|EN)ABLE|GREASE) */
 #endif
