diff --git a/include/boost/process/v1/locale.hpp b/include/boost/process/v1/locale.hpp
index e6b1048..424025b 100644
--- a/include/boost/process/v1/locale.hpp
+++ b/include/boost/process/v1/locale.hpp
@@ -78,9 +78,9 @@ inline std::locale default_locale()
     std::locale global_loc = std::locale();
     return std::locale(global_loc, new std::codecvt_utf8<wchar_t>);
 # else  // Other POSIX
